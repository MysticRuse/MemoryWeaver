# Google AI Studio API Key (for Gemini models)
GEMINI_API_KEY=your-gemini-api-key-here

# Google Cloud Storage Settings
GCS_BUCKET_NAME=memoryweaver-uploads-dev
GOOGLE_CLOUD_PROJECT=your-gcp-project-id-here

# Agent Runtime ID (from agents-cli setup)
AGENT_RUNTIME_ID=your-agent-runtime-id-here

# Flask configuration
SECRET_KEY=memoryweaver-super-secret-key-12984
PORT=5001

# Admin token guarding destructive/billable endpoints (/delete, /generate,
# pre-clean/ingest, session creation). REQUIRED for any shared/public
# deployment; leave unset for frictionless local development.
# Clients send it as the X-MW-Token header (the upload page accepts
# ?token=<value> once and remembers it).
MW_ADMIN_TOKEN=

# The "import from a folder on this computer" picker (/api/local-fs/*) browses
# the HOST machine's disk, so it is switched off automatically on Cloud Run
# (K_SERVICE is set). On any other shared host, set this to 1 to disable it.
MW_DISABLE_LOCAL_FS=
